\frametitle{Solution: broadcasting evaluates several strikes}
\begin{lstlisting}
Kgrid = np.array([90.0, 100.0, 110.0])
payoff_grid = (ST[:, None] > Kgrid[None, :]).astype(float)
price_grid = np.exp(-r * T) * np.mean(payoff_grid, axis=0)
\end{lstlisting}

\begin{propositionblock}{Array shapes}
\texttt{ST[:, None]} has shape $(n,1)$ and \texttt{Kgrid[None, :]} has shape $(1,3)$, so broadcasting produces an $(n,3)$ payoff array.
\end{propositionblock}
